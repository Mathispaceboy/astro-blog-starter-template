const year = new Date().getFullYear();
---
<footer><div class="container footer-grid"><div><a class="footer-brand" href="/">bringleads<span>.</span></a><p>Practical growth systems for ambitious B2B companies.</p></div><div><strong>Explore</strong><a href="/services">Services</a><a href="/industries">Industries</a><a href="/resources">Resources</a></div><div><strong>Company</strong><a href="/about">About</a><a href="/results">Results</a><a href="/contact">Contact</a></div><div><strong>Start a conversation</strong><a href="mailto:hello@bringleads.in">hello@bringleads.in</a><a href="/contact">Book a growth call ↗</a></div></div><div class="container footnote"><span>© {year} Bringleads. Coimbatore, India.</span><span>Built for useful growth, not vanity metrics.</span></div></footer>
<style>footer{padding:72px 0 24px;background:var(--ink);color:white;font-family:var(--font-body)}.footer-grid{display:grid;grid-template-columns:2fr repeat(3,1fr);gap:40px}.footer-grid>div{display:flex;flex-direction:column;align-items:flex-start;gap:10px}.footer-brand{font-family:var(--font-head);font-size:1.6rem;font-weight:600;text-decoration:none}.footer-brand span{color:var(--rust-dark)}footer strong{margin-bottom:8px;color:var(--rust-dark);font-family:var(--font-mono);font-size:.78rem;text-transform:uppercase;letter-spacing:.1em}footer a{color:var(--on-dark-muted);text-decoration:none;font-size:.92rem}footer p{max-width:290px;color:var(--on-dark-muted-2)}.footnote{display:flex;justify-content:space-between;margin-top:60px;padding-top:22px;border-top:1px solid var(--ink-line);color:var(--on-dark-muted-2);font-size:.8rem}@media(max-width:800px){.footer-grid{grid-template-columns:1fr 1fr}.footnote{display:grid;gap:5px}}@media(max-width:500px){.footer-grid{grid-template-columns:1fr}}</style>
