---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Contact Bringleads | Book a Growth Call" description="Tell Bringleads where B2B growth feels stuck and book a focused diagnostic conversation."><section class="page-hero"><div class="container"><p class="eyebrow">Contact</p><h1>Tell us where growth feels stuck.</h1><p class="lede">Share enough context for a useful first conversation. This is a diagnostic call, not a high-pressure sales pitch.</p></div></section><section class="section"><div class="container grid grid-2"><div><p class="eyebrow">What happens next</p><h2>A practical first step.</h2><ol class="checklist"><li>We review your context and reply by email</li><li>We schedule a 30-minute growth diagnostic</li><li>We identify the constraint and a useful next move</li><li>If there is a fit, we outline a focused engagement</li></ol><p class="notice">Prefer email? Write to <a href="mailto:hello@bringleads.in">hello@bringleads.in</a>.</p></div><form class="form card" id="contact-form"><div class="form-grid"><div class="field"><label for="name">Name *</label><input id="name" name="name" required autocomplete="name"></div><div class="field"><label for="email">Work email *</label><input id="email" name="email" type="email" required autocomplete="email"></div><div class="field"><label for="company">Company *</label><input id="company" name="company" required autocomplete="organization"></div><div class="field"><label for="website">Website</label><input id="website" name="website" type="url" placeholder="https://"></div><div class="field"><label for="industry">Industry</label><select id="industry" name="industry"><option>Manufacturing</option><option>Pumps & motors</option><option>Foundries & castings</option><option>B2B SaaS</option><option>Accounting & fintech</option><option>Other B2B</option></select></div><div class="field"><label for="market">Priority market</label><input id="market" name="market" placeholder="India, GCC, Europe…"></div></div><div class="field"><label for="challenge">What are you trying to change? *</label><textarea id="challenge" name="challenge" required placeholder="Describe the growth constraint, current approach and goal."></textarea></div><button class="button" type="submit">Prepare my enquiry ↗</button><p class="notice">Submitting opens your email app with this information ready to send. A secure website submission endpoint can be connected before launch.</p></form></div></section></SiteLayout>
<script>document.querySelector<HTMLFormElement>('#contact-form')?.addEventListener('submit',e=>{e.preventDefault();const f=new FormData(e.currentTarget);const lines=[...f.entries()].map(([k,v])=>`${k}: ${v}`);location.href=`mailto:hello@bringleads.in?subject=${encodeURIComponent('Growth enquiry from '+f.get('company'))}&body=${encodeURIComponent(lines.join('\n'))}`})</script>
