---
const path = Astro.url.pathname;
const links = [['/services','Services'],['/industries','Industries'],['/results','Results'],['/resources','Resources'],['/about','About']];
---
<header class="site-header"><div class="container nav-wrap"><a class="brand" href="/" aria-label="Bringleads home"><span class="brand-mark">B</span><span>bringleads</span></a><button class="menu" aria-expanded="false" aria-controls="nav-links">Menu</button><nav id="nav-links" aria-label="Main navigation">{links.map(([href,label]) => <a class:list={[path.startsWith(href)&&'active']} href={href}>{label}</a>)}<a class="nav-cta" href="/contact">Book a growth call <span>↗</span></a></nav></div></header>
<script>const btn=document.querySelector<HTMLButtonElement>('.menu');const nav=document.querySelector<HTMLElement>('#nav-links');btn?.addEventListener('click',()=>{const open=btn.getAttribute('aria-expanded')==='true';btn.setAttribute('aria-expanded',String(!open));nav?.classList.toggle('open')});</script>
<style>.site-header{position:sticky;top:0;z-index:20;border-bottom:1px solid rgba(216,222,216,.8);background:rgba(255,253,248,.92);backdrop-filter:blur(14px)}.nav-wrap{display:flex;align-items:center;justify-content:space-between;min-height:76px}.brand{display:flex;align-items:center;gap:10px;color:var(--ink);text-decoration:none;font-size:1.25rem;font-weight:700}.brand-mark{display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:var(--green);color:var(--lime)}nav{display:flex;align-items:center;gap:26px}nav a{color:var(--muted);font-size:.9rem;text-decoration:none;font-weight:700}nav a:hover,nav a.active{color:var(--green)}nav .nav-cta{padding:11px 16px;border-radius:99px;background:var(--ink);color:white}.menu{display:none;border:1px solid var(--line);border-radius:99px;background:white;padding:9px 13px;font:inherit;font-size:.9rem;font-weight:700}@media(max-width:900px){.menu{display:block}nav{display:none;position:absolute;left:14px;right:14px;top:68px;padding:20px;border:1px solid var(--line);border-radius:18px;background:white;box-shadow:var(--shadow);align-items:stretch;flex-direction:column;gap:4px}nav.open{display:flex}nav a{padding:10px}}</style>
