---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Contact Bringleads | Book a Growth Call" description="Tell Bringleads where B2B growth feels stuck and book a focused diagnostic conversation."><section class="page-hero"><div class="container"><p class="eyebrow">Contact</p><h1>Tell us where growth feels stuck.</h1><p class="lede">Share enough context for a useful first conversation. This is a diagnostic call, not a high-pressure sales pitch.</p></div></section><section class="section"><div class="container grid grid-2"><div><p class="eyebrow">What happens next</p><h2>A practical first step.</h2><ol class="checklist"><li>We review your context and reply by email</li><li>We schedule a 30-minute growth diagnostic</li><li>We identify the constraint and a useful next move</li><li>If there is a fit, we outline a focused engagement</li></ol><p class="notice">Prefer email? Write to <a href="mailto:hello@bringleads.in">hello@bringleads.in</a>.</p></div><form class="form card" id="contact-form"><div class="form-grid"><div class="field"><label for="name">Name *</label><input id="name" name="name" required autocomplete="name"></div><div class="field"><label for="email">Work email *</label><input id="email" name="email" type="email" required autocomplete="email"></div><div class="field"><label for="company">Company *</label><input id="company" name="company" required autocomplete="organization"></div><div class="field"><label for="website">Website</label><input id="website" name="website" type="url" placeholder="https://"></div><div class="field"><label for="industry">Industry</label><select id="industry" name="industry"><option>Manufacturing</option><option>Pumps & motors</option><option>Foundries & castings</option><option>B2B SaaS</option><option>Accounting & fintech</option><option>Other B2B</option></select></div><div class="field"><label for="market">Priority market</label><input id="market" name="market" placeholder="India, GCC, Europe…"></div></div><div class="field"><label for="challenge">What are you trying to change? *</label><textarea id="challenge" name="challenge" required placeholder="Describe the growth constraint, current approach and goal."></textarea></div><div class="field hp-field" aria-hidden="true"><label for="hp_field">Leave this field empty</label><input id="hp_field" name="hp_field" tabindex="-1" autocomplete="off"></div><button class="button" type="submit">Send my enquiry ↗</button><p class="notice" id="form-status">We'll reply by email, usually within one business day.</p></form></div></section></SiteLayout>
<style>.hp-field{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}</style>
<script>
const form = document.querySelector<HTMLFormElement>('#contact-form');
const status = document.querySelector<HTMLParagraphElement>('#form-status');
const defaultStatus = status?.textContent ?? '';
form?.addEventListener('submit', async (e) => {
	e.preventDefault();
	const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
	const data = Object.fromEntries(new FormData(form).entries());
	if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }
	if (status) { status.textContent = 'Sending your enquiry…'; status.classList.remove('notice-error', 'notice-success'); }
	try {
		const res = await fetch('/api/contact', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify(data),
		});
		const result: { ok: boolean; error?: string } = await res.json();
		if (result.ok) {
			form.reset();
			if (status) { status.textContent = "Thanks — your enquiry is on its way. We'll reply by email shortly."; status.classList.add('notice-success'); }
			if (submitBtn) { submitBtn.textContent = 'Sent ✓'; }
		} else {
			throw new Error(result.error || 'Something went wrong.');
		}
	} catch (err) {
		if (status) { status.textContent = (err as Error).message || 'Something went wrong. Please email hello@bringleads.in directly.'; status.classList.add('notice-error'); }
		if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Send my enquiry ↗'; }
	}
});
</script>
<style>#form-status.notice-success{background:var(--paper);color:var(--ink)}#form-status.notice-error{background:#fbe2d8;color:#8a3418}</style>
