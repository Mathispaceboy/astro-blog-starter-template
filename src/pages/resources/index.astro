---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CTA from '../../components/CTA.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<SiteLayout title="B2B Growth Resources | Bringleads" description="Practical tools and guides for B2B growth, export marketing, outbound and website conversion."><section class="page-hero"><div class="container"><p class="eyebrow">Resources</p><h1>Useful tools for the work behind growth.</h1><p class="lede">No content treadmill. This library will focus on checklists, templates and clear answers to high-intent problems.</p></div></section><section class="section"><div class="container"><p class="eyebrow">Guides &amp; articles</p><h2>Start here.</h2><div class="grid grid-2" style="margin-top:40px">{posts.map((post) => <a class="card card-link" href={`/blog/${post.id}`}><h3>{post.data.title}</h3><p>{post.data.description}</p></a>)}</div></div></section><section class="section cream"><div class="container grid grid-3"><div class="card"><span class="pill">Coming first</span><h3>Export Marketing Readiness Checklist</h3><p>Assess market focus, buyer proof, outreach readiness and follow-up.</p></div><div class="card"><span class="pill">Planned</span><h3>B2B Homepage Clarity Scorecard</h3><p>Review whether your homepage answers the questions that shape a shortlist.</p></div><div class="card"><span class="pill">Planned</span><h3>Outbound Campaign Brief</h3><p>Define an audience, hypothesis and message before building a list.</p></div></div></section><CTA title="Need an answer before the library grows?" text="Send us the problem. It may become the next useful resource—or the start of a focused conversation."/></SiteLayout>
