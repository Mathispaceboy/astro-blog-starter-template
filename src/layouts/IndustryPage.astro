---
import SiteLayout from './SiteLayout.astro';
import CTA from '../components/CTA.astro';
const { industry } = Astro.props;
---
<SiteLayout title={`${industry.title} Growth | Bringleads`} description={industry.summary}><section class="page-hero"><div class="container"><p class="eyebrow">Industry focus</p><h1>{industry.title}</h1><p class="lede">{industry.summary}</p><div class="button-row"><a class="button" href="/contact">Talk about your market ↗</a>{industry.demo && <a class="button button-ghost" href={industry.demo} target="_blank" rel="noopener">See a demo site ↗</a>}</div>{industry.demo && <p style="margin-top:16px;color:var(--muted);font-size:.9rem">Illustrative mockup — not a live client site.</p>}</div></section><section class="section"><div class="container grid grid-2"><div><p class="eyebrow">We understand the journey</p><h2>Generic marketing breaks down in complex B2B markets.</h2></div><div>{industry.points.map((p,i)=><div class="card" style="margin-bottom:14px"><span class="card-index">0{i+1}</span><h3>{p}</h3></div>)}</div></div></section><section class="section cream"><div class="container"><p class="eyebrow">A practical growth mix</p><h2>Build around how buyers actually shortlist.</h2><div class="grid grid-3" style="margin-top:40px"><div class="card"><h3>Clarity</h3><p>Make your relevance, proof and differentiation easy to understand.</p></div><div class="card"><h3>Visibility</h3><p>Show up in the channels and research moments that shape the shortlist.</p></div><div class="card"><h3>Conversations</h3><p>Turn relevant attention into consistent, well-qualified commercial dialogue.</p></div></div></div></section><CTA/></SiteLayout>
